# Generated by `pnpm secrets:example` from packages/config/src/schema.ts. Do not edit.
# Copy to .env.local (or run `pnpm secrets:pull`) and fill in real values.

# Runtime mode (default: development)
NODE_ENV=

# Public base URL of the app
APP_URL=http://localhost:3000

# MongoDB connection string (Atlas M0 in prod)
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name (default: sutra)
MONGODB_DB=

# Session signing secret, at least 32 chars (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Google OAuth client ID
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=replace-me

# Google Cloud project ID
GCP_PROJECT_ID=replace-me

# Cloud Run region, free tier (default: us-central1)
GCP_REGION=

# Tenant credential keyring "v1:<openssl rand -base64 32>"; prepend a new version to rotate
ENCRYPTION_KEY=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Places API key
GOOGLE_MAPS_API_KEY=replace-me

# Monthly Places request cap, kept under the free tier (default: 900)
PLACES_MONTHLY_LIMIT=

# LiteLLM proxy base URL
LITELLM_BASE_URL=http://localhost:4000

# LiteLLM proxy master key; LiteLLM requires the "sk-" prefix
LITELLM_API_KEY=sk-replace-me

# AI Studio key from a project WITHOUT billing (free tier only)
GEMINI_API_KEY=replace-me

# Requests per minute per model alias, shared by every instance (free-tier caps) (default: sutra-fast=15,sutra-smart=10)
LLM_RPM_LIMITS=

# Pub/Sub topic for Gmail push notifications ("gmail-push" or "projects/<id>/topics/<name>") (optional)
GMAIL_PUBSUB_TOPIC=

# Service account the Gmail Pub/Sub push subscription signs its OIDC tokens with (optional)
GMAIL_PUSH_SERVICE_ACCOUNT=

# Signs open/click/unsubscribe tokens, at least 32 chars
TRACKING_SECRET=replace-me-with-openssl-rand-base64-32

# Background job driver (default: inline)
JOBS_DRIVER=

# Cloud Tasks queue name for the cloud-tasks driver (optional)
CLOUD_TASKS_QUEUE=

# Service account Cloud Tasks uses to sign job requests (optional)
JOBS_OIDC_SERVICE_ACCOUNT=

# data.gov.sg CKAN resource id for the Singapore company registry (registry source); verify the dataset licence before enabling (optional)
REGISTRY_SG_RESOURCE_ID=

# Allow workspaces to enable Apollo/Hunter (default: false)
FEATURE_PAID_SOURCES=

# Public base URL exposed to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
