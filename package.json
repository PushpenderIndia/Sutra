{
  "name": "sutra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @sutra/db migrate",
    "db:seed": "pnpm --filter @sutra/db seed",
    "deploy:prod": "pnpm secrets:check && pnpm build && pnpm --filter @sutra/deploy run deploy",
    "warmup": "pnpm --filter @sutra/deploy warmup",
    "agent:try": "pnpm --filter @sutra/agents try",
    "eval": "pnpm --filter @sutra/agents eval",
    "secrets:example": "pnpm --filter @sutra/config secrets example",
    "secrets:pull": "pnpm --filter @sutra/config secrets pull",
    "secrets:push": "pnpm --filter @sutra/config secrets push",
    "secrets:check": "pnpm --filter @sutra/config secrets check",
    "i18n:translate": "pnpm --filter @sutra/web i18n:translate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
